# TDM has no multiply, divide or variable shift instructions: provide
# the 16-bit operations, and the 32-bit ones that libgcc2 takes for
# native; and -ftrapv's 16-bit operations.

LIB2ADD += $(srcdir)/config/tdm/lib2-hi.c \
	   $(srcdir)/config/tdm/lib2-si.c \
	   $(srcdir)/config/tdm/lib2-trapv.c

# Octet access through a byte pointer whose half of the word the
# compiler doesn't know, called with a convention of their own.
LIB2ADD += $(srcdir)/config/tdm/tdm-byte.S

# Out of line saves and restores of the callee-saved registers, which
# the prologues and epilogues call.
LIB2ADD += $(srcdir)/config/tdm/tdm-save.S

# Memory is small: optimize for size, and put each function in a section
# of its own, so that the link (--gc-sections) keeps only those used.
# This comes after libgcc's own -O2.
HOST_LIBGCC2_CFLAGS += -Os -ffunction-sections -fdata-sections
